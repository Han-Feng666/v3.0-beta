<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#330A73CC">
    <item android:id="@+id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/hf_button_primary" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/hf_brand_primary"
                android:endColor="@color/hf_brand_primary_dark" />
            <corners android:radius="14dp" />
            <stroke android:width="0dp" android:color="@android:color/transparent" />
        </shape>
    </item>
</ripple>
