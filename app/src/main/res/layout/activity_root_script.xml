<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <ScrollView
        android:id="@+id/scriptRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Root 脚本执行"
                android:textColor="@color/hf_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="以 Root 权限执行手机目录中的 .sh 脚本。支持文件浏览和路径记忆。"
                android:textColor="@color/hf_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="脚本路径"
                android:textColor="@color/hf_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etScriptPath"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_panel"
                    android:hint="/sdcard/script.sh"
                    android:inputType="textUri|textNoSuggestions"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/hf_text_primary"
                    android:textColorHint="@color/hf_text_secondary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnBrowse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minWidth="60dp"
                    android:text="浏览"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="脚本内容"
                android:textColor="@color/hf_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnLoad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="加载脚本"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="编辑内容"
                    android:textSize="13sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/scriptInput"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:minHeight="160dp"
                android:background="@drawable/bg_panel"
                android:gravity="top|start"
                android:hint="脚本内容将在此显示..."
                android:inputType="textMultiLine|textNoSuggestions"
                android:padding="12dp"
                android:textColor="@color/hf_text_primary"
                android:textColorHint="@color/hf_text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnTerminal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="执行脚本（自动隐藏进程）"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
