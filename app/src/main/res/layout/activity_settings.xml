<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <ScrollView
        android:id="@+id/settingsRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="设置"
                    android:textColor="@color/hf_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button"
                    android:backgroundTint="@null"
                    android:minWidth="64dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="返回"
                    android:textAllCaps="false"
                    android:textColor="@color/hf_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="使用 Shizuku 增强"
                    android:textColor="@color/hf_text_primary"
                    android:textSize="16sp" />

                <Switch
                    android:id="@+id/switchUseShizuku"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/textShizukuStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:layout_marginBottom="16dp"
                android:text="Shizuku 状态：检测中"
                android:textColor="@color/hf_text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="隐藏后台"
                    android:textColor="@color/hf_text_primary"
                    android:textSize="16sp" />

                <Switch
                    android:id="@+id/switchHideBackground"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="免广告领奖励"
                        android:textColor="@color/hf_text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/textAdFreeRewardDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="屏蔽广告域名使广告无法加载，同时放行奖励验证回调让应用认为观看完成"
                        android:textColor="@color/hf_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

                <Switch
                    android:id="@+id/switchAdFreeReward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="隐身模式（反追踪）"
                    android:textColor="@color/hf_text_primary"
                    android:textSize="16sp" />

                <Switch
                    android:id="@+id/switchStealthMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/textStealthDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:layout_marginBottom="16dp"
                android:text="开启后自动移除 URL 追踪参数，隐藏 Referer，净化浏览器指纹头"
                android:textColor="@color/hf_text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/stealthSubLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="剥离 URL 追踪参数"
                        android:textColor="@color/hf_text_secondary"
                        android:textSize="14sp" />

                    <Switch
                        android:id="@+id/switchStealthStripParams"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="隐藏 Referer"
                        android:textColor="@color/hf_text_secondary"
                        android:textSize="14sp" />

                    <Switch
                        android:id="@+id/switchStealthHideReferer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="移除浏览器指纹头"
                        android:textColor="@color/hf_text_secondary"
                        android:textSize="14sp" />

                    <Switch
                        android:id="@+id/switchStealthRemoveFingerprintHeaders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnManageCustomTrackingParams"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="管理自定义追踪参数"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textCustomTrackingParamsPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textColor="@color/hf_text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnManageCustomTrackingHeaders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="管理自定义追踪头"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textCustomTrackingHeadersPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:textColor="@color/hf_text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

            <Button
                android:id="@+id/btnResetHideBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="重置隐藏后台设置"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnShizukuAdControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="推广治理" />

            <Button
                android:id="@+id/btnAppFreeze"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="应用冻结" />

            <Button
                android:id="@+id/btnCoexistSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="加速器共存设置" />

            <Button
                android:id="@+id/btnTrafficCardSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="免费领流量卡" />

            <Button
                android:id="@+id/btnJoinGroupSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="加入群聊" />

            <Button
                android:id="@+id/btnExportLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="导出日志和崩溃报告" />

            <Button
                android:id="@+id/btnExportRules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="导出规则" />

            <Button
                android:id="@+id/btnExportCertificate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="导出 MITM 证书" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:text="Shizuku 增强"
                android:textColor="@color/hf_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnHostsEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Hosts 编辑 - 系统级域名拦截" />

            <Button
                android:id="@+id/btnNetworkPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="应用网络权限管理 - 禁用流氓应用联网" />

            <Button
                android:id="@+id/btnBackgroundRestrict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="后台限制管理 - 省电省流量" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:text="Root区（试验）"
                android:textColor="@color/hf_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRootScript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="SH 文件执行" />

            <Button
                android:id="@+id/btnRootHide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="模块隐藏" />

            <Button
                android:id="@+id/btnInstallSystemCert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="安装证书到系统 (Root)" />

            <Button
                android:id="@+id/btnModifyDeviceId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="修改 Android ID (Root)" />

            <Button
                android:id="@+id/btnModifySerial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="修改主板序列号 (Root)" />

            <Button
                android:id="@+id/btnGameAntiMark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="腾讯游戏防设备标记 (Root)" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:text="热点广告拦截"
                android:textColor="@color/hf_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="拦截热点设备广告"
                        android:textColor="@color/hf_text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="开启后连接本机热点的设备也能被拦截广告"
                        android:textColor="@color/hf_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

                <Switch
                    android:id="@+id/switchHotspotBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hotspotModeLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="拦截模式"
                    android:textColor="@color/hf_text_primary"
                    android:textSize="14sp" />

                <RadioGroup
                    android:id="@+id/rgHotspotMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbHotspotVpn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="VPN 透明代理（推荐）"
                        android:textColor="@color/hf_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:text="通过 VPN 隧道拦截热点设备流量，支持 DNS + HTTP/HTTPS 拦截"
                        android:textColor="@color/hf_text_secondary"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbHotspotDns"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="DNS 劫持（Root）"
                        android:textColor="@color/hf_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:text="用 dnsmasq 在局域网劫持 DNS 查询，拦截广告域名，需要 Root"
                        android:textColor="@color/hf_text_secondary"
                        android:textSize="12sp" />

                </RadioGroup>

                <TextView
                    android:id="@+id/tvHotspotStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/hf_text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

            <Button
                android:id="@+id/btnRewardDeveloper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="赞助开发者" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
