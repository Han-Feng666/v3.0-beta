<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF0A0A0A"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:id="@+id/terminalTitleBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FF111111"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Root 终端"
            android:textColor="#FF33FF33"
            android:textSize="13sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tvTerminalStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="连接中..."
            android:textColor="#FF666666"
            android:textSize="11sp"
            android:typeface="monospace" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/terminalScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:fadeScrollbars="false"
        android:scrollbarStyle="insideOverlay">

        <TextView
            android:id="@+id/terminalOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text=""
            android:textColor="#FF00DD00"
            android:textSize="12sp"
            android:typeface="monospace"
            android:textIsSelectable="true"
            android:lineSpacingExtra="2dp" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF222222" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FF111111"
        android:padding="4dp"
        android:minHeight="44dp">

        <TextView
            android:id="@+id/tvPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="# "
            android:textColor="#FF33FF33"
            android:textSize="13sp"
            android:typeface="monospace"
            android:paddingStart="6dp"
            android:paddingEnd="2dp" />

        <EditText
            android:id="@+id/terminalInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:imeOptions="actionSend|flagNoEnterAction"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="#FF33FF33"
            android:textColorHint="#FF335533"
            android:textSize="13sp"
            android:typeface="monospace"
            android:hint="输入命令后回车"
            android:importantForAutofill="no"
            android:longClickable="false" />
    </LinearLayout>
</LinearLayout>
