<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF0A0A0A"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:id="@+id/terminalTitleBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FF111111"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Root 终端"
            android:textColor="#FF33FF33"
            android:textSize="13sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tvTerminalStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="连接中..."
            android:textColor="#FF666666"
            android:textSize="11sp"
            android:typeface="monospace" />

        <ImageButton
            android:id="@+id/btnFontSize"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:src="@android:drawable/ic_menu_zoom"
            android:contentDescription="字体大小"
            android:tint="#FF666666" />

        <ImageButton
            android:id="@+id/btnClear"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="清屏"
            android:tint="#FF666666" />

        <ImageButton
            android:id="@+id/btnCopy"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:src="@android:drawable/ic_menu_share"
            android:contentDescription="复制"
            android:tint="#FF666666" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/terminalScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:fadeScrollbars="false"
        android:scrollbarStyle="insideOverlay">

        <TextView
            android:id="@+id/terminalOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text=""
            android:textColor="#FF00DD00"
            android:textSize="12sp"
            android:typeface="monospace"
            android:textIsSelectable="true"
            android:lineSpacingExtra="2dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/shortcutBar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:background="#FF151515"
        android:padding="2dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:background="@drawable/bg_terminal_shortcut"
            android:text="Tab"
            android:textColor="#FF88FF88"
            android:textSize="11sp"
            android:typeface="monospace" />

        <Button
            android:id="@+id/btnUp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:background="@drawable/bg_terminal_shortcut"
            android:text="↑"
            android:textColor="#FF88FF88"
            android:textSize="13sp"
            android:typeface="monospace" />

        <Button
            android:id="@+id/btnDown"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:background="@drawable/bg_terminal_shortcut"
            android:text="↓"
            android:textColor="#FF88FF88"
            android:textSize="13sp"
            android:typeface="monospace" />

        <Button
            android:id="@+id/btnCtrlC"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:background="@drawable/bg_terminal_shortcut"
            android:text="Ctrl+C"
            android:textColor="#FFFF6666"
            android:textSize="10sp"
            android:typeface="monospace" />

        <Button
            android:id="@+id/btnCtrlZ"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:background="@drawable/bg_terminal_shortcut"
            android:text="Ctrl+Z"
            android:textColor="#FFFFAA66"
            android:textSize="10sp"
            android:typeface="monospace" />

        <Button
            android:id="@+id/btnCtrlD"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:background="@drawable/bg_terminal_shortcut"
            android:text="Ctrl+D"
            android:textColor="#FFFFAA66"
            android:textSize="10sp"
            android:typeface="monospace" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF222222" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FF111111"
        android:padding="4dp"
        android:minHeight="44dp">

        <TextView
            android:id="@+id/tvPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="# "
            android:textColor="#FF33FF33"
            android:textSize="13sp"
            android:typeface="monospace"
            android:paddingStart="6dp"
            android:paddingEnd="2dp" />

        <EditText
            android:id="@+id/terminalInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:imeOptions="actionSend|flagNoEnterAction"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="#FF33FF33"
            android:textColorHint="#FF335533"
            android:textSize="13sp"
            android:typeface="monospace"
            android:hint="输入命令后回车"
            android:importantForAutofill="no"
            android:longClickable="true" />
    </LinearLayout>
</LinearLayout>
