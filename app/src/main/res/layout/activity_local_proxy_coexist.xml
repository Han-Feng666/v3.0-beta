<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="背景图"
        android:scaleType="centerCrop"
        android:src="@drawable/app_background_image" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_main" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/localProxyRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_panel"
                android:text="返回"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="配置信息"
                android:textColor="@color/hf_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="这里直接手动填写本地代理配置。寒枫会把选中的目标应用流量转发到这里。"
                android:textColor="@color/hf_text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="12dp">

                <EditText
                    android:id="@+id/hostInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_panel"
                    android:hint="本地代理地址，例如 127.0.0.1"
                    android:padding="12dp"
                    android:textColor="@color/hf_text_primary"
                    android:textColorHint="@color/hf_text_secondary"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/portInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_panel"
                    android:hint="本地代理端口，例如 7890"
                    android:inputType="number"
                    android:padding="12dp"
                    android:textColor="@color/hf_text_primary"
                    android:textColorHint="@color/hf_text_secondary"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/controllerPackageInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_panel"
                    android:hint="代理应用包名，例如 com.github.kr328.clash"
                    android:padding="12dp"
                    android:textColor="@color/hf_text_primary"
                    android:textColorHint="@color/hf_text_secondary"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/remarksInput"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_panel"
                    android:gravity="top|start"
                    android:hint="备注，例如 socks5、本机代理、测试端口"
                    android:padding="12dp"
                    android:textColor="@color/hf_text_primary"
                    android:textColorHint="@color/hf_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/detectedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_panel"
                android:padding="12dp"
                android:textColor="@color/hf_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/previewText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_panel"
                android:padding="12dp"
                android:textColor="@color/hf_text_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button"
                android:text="保存并生效"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnDisable"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_panel"
                android:text="关闭配置信息"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
