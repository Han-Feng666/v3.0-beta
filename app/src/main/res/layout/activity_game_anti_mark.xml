<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="腾讯游戏防设备标记"
            android:textColor="@color/hf_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_button"
            android:backgroundTint="@null"
            android:minWidth="64dp"
            android:text="返回"
            android:textAllCaps="false"
            android:textColor="@color/hf_text_primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="状态面板"
                android:textColor="@color/hf_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_panel"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:padding="10dp"
                android:text="正在检测 Root 与系统状态..."
                android:textColor="@color/hf_text_primary"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/switchWatcher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:checked="false"
                android:switchTextAppearance="@style/TextAppearance.AppCompat.Medium"
                android:text="启动监听（防标记守护）"
                android:textColor="@color/hf_text_primary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnPackageList"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:text="游戏包名列表"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnShowLog"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button"
                    android:backgroundTint="@null"
                    android:text="查看守护日志"
                    android:textAllCaps="false"
                    android:textColor="@color/hf_text_primary" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnRestorePermission"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button"
                    android:backgroundTint="@null"
                    android:text="手动恢复权限"
                    android:textAllCaps="false"
                    android:textColor="@color/hf_text_primary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="注意事项"
                android:textColor="@color/hf_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="1. 必须划掉后台退出游戏，否则无法触发清理。\n2. 关闭监听后建议点手动恢复权限确保 persist 目录恢复 700。\n3. 骁龙 8 Elite 5 已自动跳过权限修改，仅清理文件。\n4. 启用监听会自动随机修改 AndroidID/SSAID，需重启手机生效。"
                android:textColor="@color/hf_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
