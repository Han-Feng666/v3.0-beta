<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="组件治理"
            android:textColor="@color/hf_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_button"
            android:backgroundTint="@null"
            android:minWidth="64dp"
            android:text="返回"
            android:textAllCaps="false"
            android:textColor="@color/hf_text_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/summaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="默认只显示疑似推广组件。需要冰箱式处理时再切换到全部 Activity。"
        android:textColor="@color/hf_text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_panel"
        android:hint="搜索组件名、类型、用途或风险"
        android:inputType="text"
        android:maxLines="1"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:singleLine="true"
        android:textColor="@color/hf_text_primary"
        android:textColorHint="@color/hf_text_secondary"
        android:textSize="14sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRecommended"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:minWidth="112dp"
                android:text="推荐组件"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnSdkComponents"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:minWidth="112dp"
                android:text="SDK 组件"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnAllActivities"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:minWidth="112dp"
                android:text="全部 Activity"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnFreezeSelected"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button"
            android:backgroundTint="@null"
            android:text="冻结选中"
            android:textAllCaps="false"
            android:textColor="@color/hf_text_primary" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnUnfreezeSelected"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button"
            android:backgroundTint="@null"
            android:text="解冻选中"
            android:textAllCaps="false"
            android:textColor="@color/hf_text_primary" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnManual"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button"
            android:backgroundTint="@null"
            android:text="手动输入"
            android:textAllCaps="false"
            android:textColor="@color/hf_text_primary" />
    </LinearLayout>

    <Button
        android:id="@+id/btnDisableAllSdk"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:text="一键禁用所有 SDK 组件"
        android:textAllCaps="false"
        android:textColor="@color/hf_text_primary" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="正在读取组件..."
        android:textColor="@color/hf_text_secondary"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_panel"
        android:clipToPadding="false"
        android:padding="8dp" />

</LinearLayout>
