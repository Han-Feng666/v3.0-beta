<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/rulesBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="规则页背景图"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_fallback_rules" />

    <LinearLayout
        android:id="@+id/rulesContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="规则管理"
            android:textColor="@color/hf_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ruleSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="已导入 0 条规则"
            android:textColor="@color/hf_text_secondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/inputSearch"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:hint="搜索域名或厂商名称"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:textColor="@color/hf_text_primary"
            android:textColorHint="@color/hf_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/inputRule"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_panel"
                android:gravity="center_vertical"
                android:hint="输入域名或粘贴规则内容"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:padding="10dp"
                android:textColor="@color/hf_text_primary"
                android:textColorHint="@color/hf_text_secondary" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnAddRule"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_panel"
                android:backgroundTint="@null"
                android:minWidth="84dp"
                android:paddingHorizontal="16dp"
                android:text="添加规则"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ruleInputHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="支持域名、Hosts 和 AdGuard 域名型规则，整段内容可直接粘贴"
                android:textColor="@color/hf_text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPasteRule"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:minWidth="56dp"
                android:text="粘贴"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary"
                android:textSize="14sp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnClearInput"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:minWidth="56dp"
                android:text="清空"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRuleActions"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_panel"
                android:backgroundTint="@null"
                android:text="导入规则"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary"
                android:textSize="16sp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnSuspiciousDomains"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_panel"
                android:backgroundTint="@null"
                android:text="可疑域名"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFilter"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_panel"
                android:backgroundTint="@null"
                android:text="清理重复规则"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTrafficCard"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_panel"
                android:backgroundTint="@null"
                android:text="免费领流量卡"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary"
                android:textSize="16sp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnJoinGroup"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_panel"
                android:backgroundTint="@null"
                android:text="加入群聊"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selectionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/selectionCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="已选择 0 项"
                android:textColor="@color/hf_text_primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSelectAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:minWidth="56dp"
                android:paddingHorizontal="12dp"
                android:text="全选"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary"
                android:textSize="14sp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnDeleteSelected"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:minWidth="72dp"
                android:paddingHorizontal="12dp"
                android:text="删除所选"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary"
                android:textSize="14sp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnCancelSelection"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:minWidth="56dp"
                android:paddingHorizontal="12dp"
                android:text="取消"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="已导入规则（按厂商分类）"
            android:textColor="@color/hf_text_secondary"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel"
            android:padding="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ruleList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
