<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="8dp"
            android:text="@string/capture_settings_body_preview_section" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/capture_settings_body_preview_all_apps" />
        <SeekBar
            android:id="@+id/skAllPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/tvAllPreviewValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="textEnd"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/capture_settings_body_preview_by_app" />
        <SeekBar
            android:id="@+id/skByAppPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/tvByAppPreviewValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="textEnd"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="8dp"
            android:text="@string/capture_settings_replay_section" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/capture_settings_batch_interval" />
        <SeekBar
            android:id="@+id/skBatchInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/tvBatchIntervalValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="textEnd"
            android:paddingBottom="8dp" />

        <CheckBox
            android:id="@+id/cbConfirmRiskyReplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/capture_settings_confirm_risky_replay" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="@string/capture_settings_ui_section" />

        <CheckBox
            android:id="@+id/cbAutoScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/capture_settings_auto_scroll" />

        <CheckBox
            android:id="@+id/cbNotifyActive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/capture_settings_notify_active" />

        <CheckBox
            android:id="@+id/cbRedactExport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/capture_settings_redact_export" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="@string/capture_settings_retention_section" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/capture_settings_max_entries_label" />
        <EditText
            android:id="@+id/etMaxStoreEntries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="5000"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/capture_settings_max_age_label" />
        <EditText
            android:id="@+id/etMaxAgeDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="7"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:text="@string/capture_settings_retention_hint" />

        <Button
            android:id="@+id/btnSaveCaptureSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/capture_settings_save" />

        <!-- 批次 E6: 改写规则库入口 -->
        <Button
            android:id="@+id/btnRewriteRules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/rewrite_rules_title"
            style="@style/Widget.Material3.Button.OutlinedButton" />

    </LinearLayout>
</ScrollView>
